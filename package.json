{
  "name": "secret-notes",
  "displayName": "Secret Notes",
  "description": "Encrypt and decrypt text files in VS Code with AES-256-GCM.",
  "description_zh": "在 VS Code 中使用 AES-256-GCM 对文本文件进行加密与解密。",
  "version": "0.3.0",
  "purpose": "vscode-extension",
  "publisher": "KasukabeTsumugi",
  "engines": {
    "vscode": "^1.74.0"
  },
  "author": {
    "email": "futami16237@gmail.com",
    "name": "Kasukabe Tsumugi"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "encrypt",
    "decrypt",
    "aes",
    "security",
    "notes",
    "text"
  ],
  "repository": {
    "url": "https://github.com/baendlorel/secret-notes"
  },
  "license": "MIT",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:secret-notes.encrypt",
    "onCommand:secret-notes.decrypt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "secret-notes.encrypt",
        "title": "%command.encrypt.title%",
        "category": "%extension.category%",
        "icon": {
          "light": "assets/lock-light.svg",
          "dark": "assets/lock-dark.svg"
        }
      },
      {
        "command": "secret-notes.decrypt",
        "title": "%command.decrypt.title%",
        "category": "%extension.category%",
        "icon": {
          "light": "assets/unlock-light.svg",
          "dark": "assets/unlock-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "secret-notes.encrypt",
          "group": "navigation@0",
          "when": "secretNotes.canEncrypt"
        },
        {
          "command": "secret-notes.decrypt",
          "group": "navigation@0",
          "when": "secretNotes.canDecrypt"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "secret-notes.fileExtensions": {
          "type": "array",
          "default": [
            "txt",
            "md"
          ],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%configuration.fileExtensions.description%"
        },
        "secret-notes.exclude": {
          "type": "array",
          "default": [
            "node_modules",
            "dist",
            "out",
            "build",
            "coverage",
            ".git",
            ".next",
            ".turbo"
          ],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%configuration.exclude.description%"
        },
        "secret-notes.passwordKeepMinute": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%configuration.passwordKeepMinute.description%"
        }
      }
    }
  },
  "scripts": {
    "test-build": "pnpm build",
    "build": "rimraf out && rollup -c",
    "watch": "tsc -watch -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "lines": "tsx ./scripts/lines.ts",
    "lint": "oxlint .",
    "pub": "vsce package -o ./bin",
    "publish": "pnpm build && vsce publish"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.12.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.0.0",
    "oxlint": "^1.22.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.59.0",
    "rollup-plugin-conditional-compilation": "^2.1.2",
    "rollup-plugin-const-enum": "^1.1.5",
    "rollup-plugin-func-macro": "^1.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}