{
  "name": "encrypted-notes",
  "displayName": "Encrypted Notes",
  "description": "Encrypt and decrypt text files in VS Code with AES-256-GCM.",
  "description_zh": "在 VS Code 中使用 AES-256-GCM 对文本文件进行加密与解密。",
  "version": "0.1.0",
  "purpose": "vscode-extension",
  "publisher": "KasukabeTsumugi",
  "engines": {
    "vscode": "^1.74.0"
  },
  "author": {
    "email": "futami16237@gmail.com",
    "name": "Kasukabe Tsumugi"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "encrypt",
    "decrypt",
    "aes",
    "security",
    "notes",
    "text"
  ],
  "license": "MIT",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:encrypted-notes.toggleEncryption",
    "onCommand:encrypted-notes.encryptCurrent",
    "onCommand:encrypted-notes.decryptCurrent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "encrypted-notes.toggleEncryption",
        "title": "%command.toggleEncryption.title%",
        "category": "%extension.category%"
      },
      {
        "command": "encrypted-notes.encryptCurrent",
        "title": "%command.encryptCurrent.title%",
        "category": "%extension.category%",
        "icon": {
          "light": "assets/lock.svg",
          "dark": "assets/lock.svg"
        }
      },
      {
        "command": "encrypted-notes.decryptCurrent",
        "title": "%command.decryptCurrent.title%",
        "category": "%extension.category%",
        "icon": {
          "light": "assets/unlock.svg",
          "dark": "assets/unlock.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "encrypted-notes.encryptCurrent",
          "group": "navigation@9",
          "when": "editorTextFocus && encryptedNotes.supportedDocument && !encryptedNotes.isEncryptedDocument"
        },
        {
          "command": "encrypted-notes.decryptCurrent",
          "group": "navigation@9",
          "when": "editorTextFocus && encryptedNotes.supportedDocument && encryptedNotes.isEncryptedDocument"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "encrypted-notes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enabled.description%"
        },
        "encrypted-notes.fileExtensions": {
          "type": "array",
          "default": [
            "txt",
            "md",
            "markdown",
            "json",
            "yaml",
            "yml",
            "ini",
            "log",
            "csv"
          ],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%configuration.fileExtensions.description%"
        }
      }
    }
  },
  "scripts": {
    "lines": "clear && find ./src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" -o -name \"*.js\" -o -name \"*.mjs\" -o -name \"*.cjs\" -o -name \"*.cpp\" -o -name \"*.h\" -o -name \"*.py\"  -o -name \"*.css\" -o -name \"*.rs\" -o -name \"*.rc\" \\) | xargs wc -l",
    "test-build": "pnpm build",
    "build": "rimraf out && tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint .",
    "pub": "vsce package -o ./bin",
    "publish": "pnpm build && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.0.0",
    "oxlint": "^1.22.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
